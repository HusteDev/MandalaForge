# Store text files with LF in the repository; Git converts to the platform's line ending on checkout.
* text=auto

# Source and docs are always text.
*.py   text diff=python
*.md   text
*.html text diff=html
*.css  text diff=css
*.js   text
*.mjs  text
*.json text
*.svg  text
*.txt  text

# Scripts that must keep a specific ending regardless of platform.
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets: never convert or diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
*.ogg  binary
*.wav  binary
